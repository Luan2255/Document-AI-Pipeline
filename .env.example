# PostgreSQL connection used by SQLAlchemy.
DATABASE_URL=postgresql+psycopg://document_ai:change-me-local@localhost:5432/document_ai

# Local Compose database credentials; replace the example password before use.
POSTGRES_DB=document_ai
POSTGRES_USER=document_ai
POSTGRES_PASSWORD=change-me-local

# OpenAI-compatible chat completions endpoint configuration.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=45

# Upload and OCR limits; OCR_LANGUAGES must be installed in Tesseract.
MAX_UPLOAD_SIZE_BYTES=15728640
MAX_PDF_PAGES=20
OCR_LANGUAGES=por+eng
LOG_LEVEL=INFO